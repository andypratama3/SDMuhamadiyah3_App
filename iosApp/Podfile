# Firebase Cloud Messaging for SDM3 Parent (iOS)
# Docs: https://github.com/firebase/firebase-ios-sdk
#
# Setup (sekali):
#   1. Download GoogleService-Info.plist dari Firebase Console
#   2. ./scripts/setup-firebase-config.sh   (atau salin manual ke iosApp/iosApp/)
#   3. cd iosApp && pod install
#   4. Buka iosApp.xcworkspace (bukan .xcodeproj)
#
# JANGAN commit GoogleService-Info.plist — file asli ada di .gitignore

platform :ios, '15.0'
use_frameworks!

target 'iosApp' do
  pod 'FirebaseCore'
  pod 'FirebaseMessaging'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
